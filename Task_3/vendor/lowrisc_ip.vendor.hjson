{
    name: "lowrisc_ip",
    target_dir: "lowrisc_ip",
    patch_dir: "patches/lowrisc_ip",

    upstream: {
        url: "https://github.com/lowRISC/opentitan",
        // Revision hash is fixed for reproducibility.
        // rev: "earlgrey_1.0.0",
        rev: "ddc6f6144995624f2c7f181cfb4a3ce7e675b373",
    }

    mapping: [
        {from: "util/tlgen.py",        to: "util/tlgen.py"},
        {from: "util/tlgen",           to: "util/tlgen", patch_dir: "tlgen"},
        {from: "util/reggen",          to: "util/reggen", patch_dir: "reggen"},

        {from: "hw/ip/tlul",         to: "ip/tlul", patch_dir: "tlul"},
        {from: "hw/ip/uart",         to: "ip/uart", patch_dir: "uart"},
        {from: "hw/ip/prim",         to: "ip/prim", patch_dir: "prim"},
        //Added by Deyaa Al-Khati, 17th of feb 2026
        {from: "hw/ip/lc_ctrl",      to: "ip/lc_ctrl"},
        {from: "hw/ip/spi_host",     to: "ip/spi_host", patch_dir: "spi_host"},
        {from: "hw/ip/spi_device",   to: "ip/spi_device", patch_dir: "spi_device"},
        {from: "hw/ip/rv_dm",         to: "ip/rv_dm", patch_dir: "rv_dm"},
        //end 
        //Added by Deyaa Al-Khati, 4th of march 2026
        {from: "hw/ip/rv_timer", to: "ip/rv_timer"},
        {from: "hw/top_earlgrey/ip_autogen/rv_plic", to: "ip/rv_plic"},
        //end
        {from: "hw/ip/prim_generic", to: "ip/prim_generic"},

        {from: "hw/top_earlgrey/top_pkg.core",   to: "ip/top_pkg/top_pkg.core"},
        {from: "hw/top_earlgrey/rtl/top_pkg.sv", to: "ip/top_pkg/rtl/top_pkg.sv"},

        {from: "hw/dv/dpi/uartdpi",    to: "dv/dpi/uartdpi", patch_dir: "uartdpi"},
    ]
}
